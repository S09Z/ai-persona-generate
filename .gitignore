# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv*

# Env secrets
.env

# Model weights (large files)
models/
*.safetensors
*.ckpt
*.pt
*.bin

# Ruff cache
.ruff_cache/

# Vendored subprojects (cloned separately, not committed)
vendor/

# VS Code - ignore user-specific files, keep shared settings
.vscode/
# !.vscode/settings.json
# !.vscode/extensions.json
# !.vscode/launch.json

# Keep outputs folder but ignore generated files inside
outputs/*
!outputs/.gitkeep

# Keep empty scaffold folders
!prompts/.gitkeep
!workflows/.gitkeep

datasets/**
!datasets/**/
!datasets/**/*.txt


# Instagram session cookies (secret)
ig_cookies.json
!datasets/**/manifest.csv

# Generated candidate and evaluation images (keep only the locked master face, contact sheets and settings)
characters/*/master_face/candidates*/
characters/*/reference_sheet*/*.png
experiments/*/evaluation/*/
logs/lora_*/
!logs/lora_auri/

# MODEL_001 synthetic dataset images (manifest.json stays tracked)
characters/model_001/dataset/*.png
