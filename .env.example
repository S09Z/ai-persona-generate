MODEL_ID=stabilityai/sdxl-turbo
# Or swap for a local .safetensors path:
# MODEL_PATH=./models/your_model.safetensors

DEVICE=mps
# Options: mps (Apple Silicon), cuda (NVIDIA), cpu

OUTPUT_DIR=./outputs
CHARACTER_DIR=./characters
DEFAULT_CHARACTER=luna

# Image generation settings
STEPS=30
GUIDANCE_SCALE=7.5
WIDTH=1024
HEIGHT=1024

# HuggingFace — get your token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Suppress macOS symlink warning from HF Hub
HF_HUB_DISABLE_SYMLINKS_WARNING=1
